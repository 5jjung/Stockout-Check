# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 깃허브에 올라가지 않습니다)

# 구글 시트 주소 /d/ 와 /edit 사이의 값
SPREADSHEET_ID=

# 서비스계정 키: credentials.json 파일을 이 폴더에 두면 비워 둬도 됩니다.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# 슬랙 알림 (비우면 시트 기록만)
SLACK_WEBHOOK_URL=

# npm run watch 반복 간격(분)
INTERVAL_MINUTES=5

# false = 크롬 창을 띄워서 확인 / BROWSER_CHANNEL=chrome = PC에 설치된 크롬 사용
HEADLESS=true
# BROWSER_CHANNEL=chrome

# 동시에 확인하는 상품 수
CONCURRENCY=3
